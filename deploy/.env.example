# bmsync deployment config example
#
#   cp .env.example .env && vi .env
#
# .env is git-ignored and never committed.

# Required. At least 32 random chars, generate with:
#   openssl rand -hex 32
BMSYNC_TOKEN=

# Optional. Listen address, default ":8080"
BMSYNC_ADDR=":8080"

# Optional. Data directory, default "/data"
BMSYNC_DATA="/data"

# Optional. History snapshots to keep, default 30
BMSYNC_HISTORY_KEEP=30

# Optional. Tombstone retention days, default 90
BMSYNC_TOMBSTONE_TTL_DAYS=90
