# bmsync 部署配置示例
#
#   cp .env.example .env && vi .env
#
# .env 已被 .gitignore 忽略，不会入库。

# 必填。至少 32 字符的随机串，生成方式：
#   openssl rand -hex 32
BMSYNC_TOKEN=

# 可选。服务监听地址，默认 ":8080"
BMSYNC_ADDR=":8080"

# 可选。数据目录，默认 "/data"
BMSYNC_DATA="/data"

# 可选。保留的历史快照份数，默认 30
BMSYNC_HISTORY_KEEP=30

# 可选。墓碑保留天数，默认 90
BMSYNC_TOMBSTONE_TTL_DAYS=90
