' bmsync — POST /api/sync end-to-end sequence
' Code refs: ApiEndpoints.HandleSyncAsync (ApiEndpoints.cs:34),
' BmsyncServer middleware order (BmsyncServer.cs:88-136),
' BookmarkStore.SyncAsync (BookmarkStore.cs:165), Merger.Merge (Merge.cs:159)

@startuml seq-sync
title POST /api/sync sync sequence

actor "User" as U
participant "Extension\nbackground/runSync" as Ext
participant "Middleware\naccess log->Auth.Protect" as Mid
participant "ApiEndpoints\nHandleSyncAsync" as Api
participant "BookmarkStore\nSyncAsync" as Store
participant "Merger.Merge\n+ TombstoneGc" as Merge
database "Disk\nstate/conflicts/history" as Disk

U -> Ext : Click Sync now (request host permission inside the gesture first)
Ext -> Mid : POST /api/sync {device, state, base}
note right of Mid : Rate-limit first, then auth; /api/health skips auth

alt Rate limit exceeded -> 429 / bad token -> 401
  Mid --> Ext : 4xx (touches no state)
  note right of Ext : Non-200 never touches local bookmarks\n(design.md §9.6)
else Allowed
  Mid -> Api : ctx (HttpContext passed explicitly)
  Api -> Api : ReadBody (16MB cap) -> ParseRequest\n-> schema version -> State.Validate()
  alt Malformed/over limit -> 400
    Api --> Ext : bad_request / validation_failed
  else Valid
    Api -> Store : SyncAsync(incoming, base, device)
    activate Store
    Store -> Store : _gate.WaitAsync (serialized critical section)
    Store -> Disk : SnapshotLockedAsync (pre-write snapshot, failure is non-blocking)
    Store -> Merge : Merger.Merge(server, incoming, base, device, now)
    activate Merge
    Merge -> Merge : ObserveMany(client timestamps)\n-> union keys in lexicographic order -> LWW decision\n-> three-way conflict detection (observe-only) -> MergeInvariants
    Merge --> Store : MergeResult{State, Conflicts, Summary}
    deactivate Merge
    Store -> Store : TombstoneGc.CollectFrom (expired tombstones counted as Deleted)
    Store -> Store : _clock.Update(MaxHlc) -> ticked.Validate()
    Store -> Disk : SaveLockedAsync (tmp->fsync->rename)
    Store -> Disk : AppendConflictsLockedAsync (ring 500)
    Store --> Api : MergeResult (authoritative state)
    deactivate Store
    Api --> Ext : 200 {state, summary, conflicts, hlc, serverTime}
    Ext -> Ext : HLC calibrate -> planApply -> executePlan\n-> saveState (full cache replace)
  end
end
@enduml
