' bmsync — C4 Level 3: server components (maps to the four projects under bmsync/src)
' Dependency direction is strictly one-way: Cli -> Server -> Store -> Domain (see README why-three-projects)

@startuml c4-component-server
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title bmsync server components (C4 Level 3)

Container_Boundary(srv, "bmsync process") {

  Component(cli, "BookmarkSync.Cli", "Entry", "Program/Cli.Run: healthcheck subcommand, --config-check, Kestrel start + graceful shutdown\nProgram.cs")
  Component(build, "BmsyncServer.Build", "Assembly", "Register Store/rate-limiting/ApiEndpoints; middleware: access log -> auth (UseWhen); map 4 routes\nBmsyncServer.cs")
  Component(auth, "Auth.Protect", "Trust boundary", "Rate-limit first, then Bearer constant-time compare; XFF takes first segment only\nAuth.cs + RateLimiter.cs")
  Component(api, "ApiEndpoints", "Handlers (thin)", "HandleSyncAsync / HandleHealthAsync / HandleConflictsAsync / HandleHistoryAsync\nApiEndpoints.cs")
  Component(store, "BookmarkStore", "Persistence", "SemaphoreSlim serializes read->merge->GC->write; snapshots outside the lock; conflict buffer\nBookmarkStore.cs + FileOps.cs")
  Component(domain, "Domain (pure logic)", "Domain layer", "State.Validate / Merger.Merge / Hlc / TombstoneGc / Limits\nZero project references, zero logging interfaces")

  Rel(cli, build, "Build(cfg)", "")
  Rel(build, auth, "Mount middleware", "")
  Rel(build, api, "MapGet/MapPost", "")
  Rel(api, store, "SyncAsync / counts / conflicts / snapshots", "")
  Rel(api, domain, "State.Validate", "")
  Rel(store, domain, "Merger.Merge / TombstoneGc / Hlc clock", "")
}

' Domain references no project: to change the merge algorithm only look at bmsync/src/BookmarkSync.Domain/
@enduml
