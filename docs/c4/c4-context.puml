' bmsync — C4 Level 1: system context
' Only produces .puml, no rendering. Keep the matching docs/design.md section in sync when changing.
' Rendering needs C4-PlantUML: https://github.com/plantuml-stdlib/C4-PlantUML

@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title bmsync system context (C4 Level 1)

Person(personal, "Personal PC", "Firefox + BM Sync extension")
Person(company, "Work PC", "Firefox + BM Sync extension, cannot log into personal accounts")

System(bmsync, "bmsync", "Self-hosted bookmark sync server: manually triggered two-way merge (LWW + HLC), deletions sync")
System_Ext(npm, "Nginx Proxy Manager", "Existing reverse proxy: TLS termination, client_max_body_size 32m")
System_Ext(vps, "VPS", "Docker host, bmsync binds only 127.0.0.1:8080")

Rel(personal, bmsync, "Sync bookmark tree", "HTTPS (via NPM)")
Rel(company, bmsync, "Sync bookmark tree", "HTTPS (via NPM)")
Rel(bmsync, npm, "Plain HTTP", "127.0.0.1:8080")
Rel(npm, vps, "Deployed on", "")
Rel(bmsync, vps, "Runs on", "Docker, FROM scratch")

' Biggest unknown (HANDOVER §5.4): if the corporate network blocks the self-hosted domain, the whole left-side link is unusable
@enduml
