' bmsync — C4 Level 2: containers
' Container = independently deployable/runnable unit. bmsync is a ~20-30 MB NativeAOT single binary.

@startuml c4-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title bmsync containers (C4 Level 2)

Person(user, "User", "Clicks Sync now in Firefox on both PCs")

Container(fx, "Firefox extension", "Pure ESM, no build", "Collect bookmark tree -> POST /api/sync -> apply authoritative state")
Container(bmsync, "bmsync", ".NET 10 NativeAOT single binary, Kestrel", "Merge (LWW+HLC), auth, rate limiting, persistence, snapshots")
ContainerDb(data, "Data directory", "state.json / conflicts.json / history/", "Authoritative state + conflict ring buffer (500) + latest 30 snapshots")
Container(npm, "Nginx Proxy Manager", "User-provided", "TLS + client_max_body_size 32m")

Rel(user, fx, "Click sync / configure address+token", "")
Rel(fx, npm, "HTTPS", "")
Rel(npm, bmsync, "HTTP", "127.0.0.1:8080")
Rel(bmsync, data, "Atomic write/read", "tmp->fsync->rename")

' Key constraint: merging is implemented in exactly one place inside bmsync; the extension only does the two mechanical directions: collect/apply
@enduml
