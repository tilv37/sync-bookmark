<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HTTP 层与进程入口的单元测试。
    HTTP 层与进程入口的单元测试，用例在服务端从 Go 迁移到 .NET 10 时逐条移植。

    用 WebApplicationFactory 起真实的 Kestrel 管道：中间件顺序、
    限流、鉴权、错误响应格式这些恰恰是"用 TestServer 单独测就测不到"
    的部分 —— 顺序错了 TestServer 不会告诉你，只有整条管道跑起来才会。
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Server.Tests</RootNamespace>
    <AssemblyName>BookmarkSync.Server.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BookmarkSync.Server\BookmarkSync.Server.csproj" />
    <ProjectReference Include="..\..\src\BookmarkSync.Store\BookmarkSync.Store.csproj" />
    <ProjectReference Include="..\..\src\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
    <!--
      入口项目是 Exe，测试需要直接引用它才能测 -config-check 与
      healthcheck 子命令。引用 Exe 在 .NET 里是允许的（产出程序集可被引用）。
    -->
    <ProjectReference Include="..\..\src\BookmarkSync.Cli\BookmarkSync.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
