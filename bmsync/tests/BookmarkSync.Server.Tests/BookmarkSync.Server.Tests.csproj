<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the HTTP layer and process entry point.
    Cases were ported one by one when the server migrated from Go to .NET 10.

    Uses WebApplicationFactory to boot the real Kestrel pipeline: middleware ordering,
    rate limiting, auth, and error response shape are precisely the parts that "testing alone with TestServer cannot cover"
    — wrong ordering stays invisible under TestServer; only the full pipeline reveals it.
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Server.Tests</RootNamespace>
    <AssemblyName>BookmarkSync.Server.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BookmarkSync.Server\BookmarkSync.Server.csproj" />
    <ProjectReference Include="..\..\src\BookmarkSync.Store\BookmarkSync.Store.csproj" />
    <ProjectReference Include="..\..\src\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
    <!--
      The entry project is an Exe; tests need to reference it directly to cover the -config-check and
      healthcheck subcommands. Referencing an Exe is allowed in .NET (its output assembly is referenceable).
    -->
    <ProjectReference Include="..\..\src\BookmarkSync.Cli\BookmarkSync.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
