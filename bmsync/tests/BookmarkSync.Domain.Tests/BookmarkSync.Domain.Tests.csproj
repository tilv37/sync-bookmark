<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain-layer unit tests.

    Cases were ported one by one when the server migrated from Go to .NET 10; keeping the count (~60) aligned with the
    Go side is intentional: any shortfall usually means some edge case was "simplified away" during
    porting, and that is exactly where behavior changes sneak in unnoticed.
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Domain.Tests</RootNamespace>
    <AssemblyName>BookmarkSync.Domain.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
