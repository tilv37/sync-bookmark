<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence layer: atomic state.json read/write, mutex serialization, history snapshots, conflict buffer.

    Dependency direction: depends only downward on Domain, knows nothing about HTTP. A reverse dependency happened once (the original Go
    implementation had store referencing server.Config), whose cost was the absurdity that "the persistence layer needs to know the token
    and listen address". StoreOptions exists to stop that from happening again.
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Store</RootNamespace>
    <AssemblyName>BookmarkSync.Store</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Store.Tests" />
  </ItemGroup>

</Project>
