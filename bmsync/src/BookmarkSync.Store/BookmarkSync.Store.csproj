<Project Sdk="Microsoft.NET.Sdk">

  <!--
    持久化层：state.json 的原子读写、互斥串行化、历史快照、冲突缓冲。

    依赖方向：只向下依赖 Domain，不认识 HTTP。反向依赖过一次（原来的 Go
    实现让 store 引用了 server.Config），代价是"持久化层需要知道 Token
    和监听地址"这种荒唐的事。这里用 StoreOptions 挡住它再次发生。
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Store</RootNamespace>
    <AssemblyName>BookmarkSync.Store</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Store.Tests" />
  </ItemGroup>

</Project>
