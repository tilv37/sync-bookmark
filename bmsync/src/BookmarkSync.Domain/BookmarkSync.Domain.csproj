<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain layer: data models, merge algorithm, HLC, tombstone GC.

    The only code in the project that needs repeated close reading, and the only layer that
    must be testable detached from HTTP and from disk. Hence one hard constraint:

      **Depends on no other project, and on no logging/IO framework.**

    Inputs and outputs are value types, no IO, no clock (clock is injected), so 2000+
    merge assertions run in milliseconds — which is exactly why the merge algorithm can be trusted.

    The only external dependency is the ILogger interface from Microsoft.Extensions.Logging.Abstractions.
    Even that could be removed, at the cost of the store layer abstracting logging itself; not worth it yet.
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Domain</RootNamespace>
    <AssemblyName>BookmarkSync.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Domain.Tests" />
  </ItemGroup>

</Project>
