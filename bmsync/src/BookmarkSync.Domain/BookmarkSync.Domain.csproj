<Project Sdk="Microsoft.NET.Sdk">

  <!--
    领域层：数据模型、合并算法、HLC、墓碑 GC。

    这是整个项目唯一需要反复精读的代码，也是唯一"必须能脱离 HTTP、
    脱离磁盘被测试"的一层。因此它有一条硬约束：

      **不依赖任何其他项目，也不依赖任何日志/IO 框架。**

    输入输出都是值类型，没有 IO、没有时钟（时钟靠注入），所以 2000 多个
    合并断言可以在毫秒内跑完 —— 而这正是合并算法敢被信任的原因。

    唯一的外部依赖是 Microsoft.Extensions.Logging.Abstractions 的 ILogger
    接口。连它都可以再拿掉，代价是 store 层要自己抽象日志；目前不值得。
  -->

  <PropertyGroup>
    <RootNamespace>BookmarkSync.Domain</RootNamespace>
    <AssemblyName>BookmarkSync.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Domain.Tests" />
  </ItemGroup>

</Project>
