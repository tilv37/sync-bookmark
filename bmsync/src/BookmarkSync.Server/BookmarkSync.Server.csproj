<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    HTTP layer: routing, auth, rate limiting, request/response codec.

    Uses ASP.NET Core Minimal API instead of MVC / controllers: no views,
    no model binding, no content-negotiation needs here; one more abstraction layer would only make
    "what exactly does this endpoint validate" require jumping around to answer. Four endpoints, short enough to read at a glance.

    It is the only project holding the trust boundary (Authentication.cs), so every change to that file
    should be a deliberate decision, not a drive-by refactor.
  -->

  <PropertyGroup>
    <!--
      The Web SDK defaults OutputType to Exe, but this project is a library: the real entry point lives in
      BookmarkSync.Cli. Keeping the default yields CS5001 (no Main found).
    -->
    <OutputType>Library</OutputType>
    <RootNamespace>BookmarkSync.Server</RootNamespace>
    <AssemblyName>BookmarkSync.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookmarkSync.Store\BookmarkSync.Store.csproj" />
    <ProjectReference Include="..\BookmarkSync.Domain\BookmarkSync.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Server.Tests" />
  </ItemGroup>

  <!--
    No <FrameworkReference Include="Microsoft.AspNetCore.App" />:
    the Web SDK already references it implicitly; writing it again explicitly triggers a NETSDK1086 warning,
    and since this solution sets TreatWarningsAsErrors=true, that would fail the build directly.
  -->

</Project>
