<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Process entry point: starts Kestrel, registers middleware and routes,
    graceful shutdown, healthcheck subcommand.

    Uses the Web SDK instead of a plain Exe: the entry point needs the ASP.NET Core
    WebApplication type. AssemblyName is pinned to bmsync — not for looks,
    but because the docker HEALTHCHECK and ops docs hard-code /bmsync;
    renaming it would turn all deployed containers unhealthy.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookmarkSync.Cli</RootNamespace>
    <AssemblyName>bmsync</AssemblyName>

    <!--
      The two settings below must stay separate because they solve two different problems:

      1. JsonSerializerIsReflectionEnabledByDefault=false — **always** in effect.
         It turns "used reflection-based JSON" into a hard runtime error instead of a silent slow path.
         Why always on: this project uses the System.Text.Json source generator
         (see Server/ApiJsonContext.cs), the protocol type list lives in code,
         so protocol changes surface immediately as compile errors. The default is true; once someone writes
         JsonSerializer.Serialize(someAnonymousType), it runs on a local dev machine but
         blows up only when published to the scratch image — the worst possible time.

      2. PublishAot — enabled **only at publish time**, triggered by Dockerfile passing
         -p:PublishAot=true.
         NativeAOT drops the need for .so / libicu / libssl, the only viable way to use FROM scratch;
         but it needs a C++ linker (the "Desktop Development with C++" workload with Visual Studio on Windows,
         clang on Linux), and it **cannot cross-compile**: publishing -r linux-x64 on Windows yields
         "Cross-OS native compilation is not supported". So it must be left to the Linux container;
         local dev machines cannot do it.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookmarkSync.Server\BookmarkSync.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookmarkSync.Server.Tests" />
  </ItemGroup>

  <!-- Same as Server.csproj: the Web SDK implicitly references ASP.NET Core, no duplicate declaration. -->

</Project>
